---
// One point of a list of points (Points.astro): `title` as its heading, the slot as its
// sentence. A rule opens it, as a ledger's row.
interface Props {
	title: string;
}
const { title } = Astro.props;
---

<li class="point rule-top">
	<h3 class="rv rv-wipe">{title}</h3>
	<div class="text rv rv-fade"><slot /></div>
</li>

<style>
	.point {
		display: grid;
		align-content: start;
		gap: var(--space-3);
		padding-block: var(--space-4) var(--space-5);
		min-width: 0;
	}
	/* As wide as its text, so the window that uncovers it ends where the heading does. */
	h3 {
		justify-self: start;
		font-family: var(--font-brand);
		font-weight: var(--weight-title);
		font-size: var(--text-skill);
		line-height: var(--leading-tight);
		letter-spacing: var(--tracking-tight);
		color: var(--color-text);
		overflow-wrap: anywhere;
	}
	/* The page writes the sentence as a paragraph of its own inside this block. */
	.text {
		max-width: var(--measure);
		color: var(--color-text);
	}
	.text :global(p) {
		margin: 0;
		text-wrap: pretty;
	}
	.text :global(code) {
		font-family: var(--font-mono);
		font-size: var(--text-xs);
	}
</style>
