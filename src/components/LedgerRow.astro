---
// One ledger row: `term` in the mono key column, the slot as its value.
interface Props {
	term: string;
}
const { term } = Astro.props;
---

<div class="row">
	<dt>{term}</dt>
	<dd><slot /></dd>
</div>

<style>
	.row {
		display: grid;
		grid-template-columns: var(--ledger-key-width) minmax(0, 1fr);
		align-items: baseline;
		gap: var(--space-1) var(--space-4);
		padding-block: var(--space-4);
		border-top: var(--border-width) solid var(--color-border);
	}
	dt {
		font-family: var(--font-mono);
		font-size: var(--text-sm);
		color: var(--color-text);
		overflow-wrap: anywhere;
	}
	dd {
		display: grid;
		gap: var(--space-2);
		max-width: var(--measure);
		margin: 0;
		min-width: 0;
		color: var(--color-text);
		overflow-wrap: break-word;
	}
	dd :global(a) {
		color: var(--color-text);
		text-decoration: underline;
		text-decoration-color: var(--color-accent);
		text-underline-offset: var(--space-1);
	}
	dd :global(a:hover) {
		color: var(--color-accent);
	}
	dd :global(a:active) {
		opacity: var(--press-opacity);
	}
	dd :global(code) {
		display: inline-block;
		max-width: 100%;
		vertical-align: bottom;
		overflow-wrap: anywhere;
		font-family: var(--font-mono);
		font-size: var(--text-xs);
		padding: var(--space-1) var(--space-2);
		background: var(--color-code-bg);
		border: var(--border-width) solid var(--color-code-border);
	}
	/* Token --ledger-stack-width: a narrow ledger, also with enlarged text, puts the key above its value. */
	@container (max-width: 24rem) {
		.row {
			grid-template-columns: minmax(0, 1fr);
		}
	}
</style>
