---
// Two landing sections side by side on a wide page, one after the other otherwise.
---

<div class="landing-columns-frame not-content">
	<div class="landing-columns"><slot /></div>
</div>

<style>
	.landing-columns-frame {
		container: landing-columns / inline-size;
	}
	.landing-columns {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
	}
	/* Token --breakpoint-columns. */
	@container landing-columns (min-width: 68rem) {
		.landing-columns {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			column-gap: var(--space-8);
			align-items: start;
		}
	}
</style>
