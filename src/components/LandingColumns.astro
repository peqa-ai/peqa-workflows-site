---
// Two landing sections side by side on a wide page, one after the other otherwise. Side by
// side, the first takes five eighths of the width and both ledgers a narrower key column, so
// each value of «Dónde funciona» keeps to one line.
---

<div class="landing-columns-frame not-content">
	<div class="landing-columns"><slot /></div>
</div>

<style>
	.landing-columns-frame {
		container: landing-columns / inline-size;
	}
	.landing-columns {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
	}
	/* Token --breakpoint-columns. */
	@container landing-columns (min-width: 80rem) {
		.landing-columns {
			--ledger-key-width: var(--ledger-key-width-compact);
			grid-template-columns: minmax(0, 5fr) minmax(0, 3fr);
			column-gap: var(--space-8);
			align-items: start;
		}
	}
</style>
