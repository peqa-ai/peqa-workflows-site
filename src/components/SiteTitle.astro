---
// The site title in peqa.ai's brand signature (website src/components/Brand.js): lowercase
// glyphs, the suffix in the accent and a caret. Screen readers hear the title as configured.
const { siteTitle, siteTitleHref } = Astro.locals.starlightRoute;
const [lead, ...rest] = siteTitle.toLowerCase().split(' ');
---

<a href={siteTitleHref} class="site-title">
	<span class="sr-only">{siteTitle}</span>
	<span class="brand" aria-hidden="true" translate="no">
		<span class="glyphs">{lead} <span class="suffix">{rest.join(' ')}<span class="caret"></span></span></span>
	</span>
</a>

<style>
	.site-title {
		display: inline-flex;
		align-items: center;
		min-width: 0;
		min-height: var(--touch-target);
		color: var(--color-text);
		text-decoration: none;
	}
	.brand {
		display: inline-flex;
		align-items: flex-end;
		font-family: var(--font-brand);
		font-weight: var(--weight-title);
		font-size: min(var(--text-md), var(--brand-max-size));
		line-height: var(--brand-leading);
	}
	/* «peqa» and «workflows» share a line while they fit; with larger text in a narrow header the
	   suffix takes the next line instead of being cut off. */
	.glyphs {
		padding-block: var(--brand-mask-top) var(--brand-mask-bottom);
		letter-spacing: var(--brand-tracking);
	}
	.suffix {
		color: var(--color-accent);
	}
	/* Inside the suffix, so it stays after «workflows» when the title takes two lines. */
	.caret {
		display: inline-block;
		width: var(--brand-caret-width);
		height: var(--brand-caret-height);
		margin-left: var(--brand-caret-gap);
		vertical-align: var(--brand-caret-baseline);
		background: var(--color-accent);
		transition: background var(--motion-duration) var(--motion-ease);
	}
	.site-title:hover .caret {
		background: var(--color-text);
	}
	.site-title:active {
		opacity: var(--press-opacity);
	}
	.site-title:focus-visible {
		outline-offset: var(--focus-offset);
	}
	/* Token --breakpoint-nav: the header grows with Starlight's larger nav. */
	@media (min-width: 50em) {
		.brand {
			font-size: min(var(--text-lg), var(--brand-max-size));
		}
	}
</style>
