---
// The landing's hero scene, translated from peqa.ai's Scene.js (scene `peqa-workflows`) into
// one vertical piece: the agent session above, the pull request below. It tells one story in
// beats of --scene-beat (scene.css), once: b1 plays at the second beat. It starts on load or,
// if it is still below the screen then, as it comes into view. The markup is the final frame.
// Assistive technology reads the scene as one image described by its story.
import { sceneCopy } from '../data/scene';
import '../styles/scene.css';

const t = sceneCopy[Astro.locals.starlightRoute.lang === 'en' ? 'en' : 'es'];
// The three subagents start together; the first finishes a beat before the other two.
const agents = t.agents.map((agent, index) => ({ ...agent, y: 126 + index * 20, done: index > 0 ? 'b3' : 'b2' }));
---

<figure class="hero-scene" role="img" aria-label={t.label}>
	<svg class="scene-art" viewBox="0 0 260 420" aria-hidden="true" focusable="false">
		{/* The agent session: the request, then three subagents working in parallel. */}
		<rect class="screen" x="2" y="2" width="256" height="184" />
		<text class="label" x="14" y="22">{t.session}</text>
		<line class="rule" x1="2" y1="32" x2="258" y2="32" />
		<rect class="panel" x="14" y="42" width="232" height="42" />
		<path class="icon" d="M21 49l4 4-4 4" />
		<g class="enter">
			<text class="small" x="32" y="57">{t.command}</text>
			<text class="small" x="32" y="74" data-example>{t.request}</text>
		</g>
		<g class="enter b1">
			<text class="label" x="14" y="106">{t.subagents}</text>
			{
				agents.map(({ name, file, y }) => (
					<>
						<text class="small" x="14" y={y}>{name}</text>
						<text class="label" x="86" y={y}>{file}</text>
					</>
				))
			}
		</g>
		{
			agents.map(({ y, done }, index) => (
				<>
					<g class:list={['interim', 'b1', index > 0 && 'span2']}>
						<rect class="accent breathe" x="231" y={y - 9} width="7" height="7" />
					</g>
					<path class:list={['check', 'enter', done]} d={`M228 ${y - 4}l4 4 8-9`} />
				</>
			))
		}

		{/* The pull request: it opens, revisa reviews it and the person decides the merge, the
		    scene's one lit step. */}
		<rect class="screen" x="2" y="200" width="256" height="218" />
		<text class="label" x="14" y="220">{t.pullRequest}</text>
		<line class="rule" x1="2" y1="230" x2="258" y2="230" />
		<g class="slide b4">
			<text class="strong" x="14" y="254" data-example>{t.pr}</text>
			<text class="small" x="14" y="274">{t.prTitle}</text>
			<rect class="ink" x="14" y="286" width="8" height="8" />
			<text class="small" x="28" y="294">{t.open}</text>
		</g>
		<g class="enter b5">
			<text class="small" x="14" y="322">{t.review}</text>
			<rect class="tag" x="134" y="309" width="110" height="18" />
			<text class="tag-text" x="189" y="322" text-anchor="middle">{t.noFindings}</text>
		</g>
		<g class="enter b6">
			<line class="rule" x1="14" y1="338" x2="246" y2="338" />
			<text x="14" y="362">{t.ask}</text>
			<rect class="button lit b7" x="14" y="374" width="110" height="30" />
			<text class="lit-text b7" x="69" y="394" text-anchor="middle">{t.merge}</text>
			<circle class="tap b7" cx="69" cy="389" r="16" />
			<text class="label" x="136" y="393">{t.later}</text>
		</g>
	</svg>
</figure>

<script>
	import { belowScreen, playOnView, reducedMotion } from '../lib/play-on-view';

	// On a phone the scene follows the install commands, below the screen at load: it waits on
	// its first frame there and plays as it comes into view. A hidden scene has no box, so it
	// is never below the screen and stays as it is.
	const scene = document.querySelector<HTMLElement>('.hero-scene');
	if (scene && !reducedMotion() && belowScreen(scene)) playOnView([scene]);
</script>

<style>
	.hero-scene {
		margin: 0;
		min-width: 0;
		font-size: var(--text-sm);
	}
	/* The column's width, up to 260 units (the drawing's width, its viewBox) at
	   --scene-unit-column, or at the unit the hero passes in --hero-scene-unit. In em, so the
	   scene grows with the reader's text; the hero hides it below --breakpoint-scene. */
	svg {
		width: 100%;
		max-width: calc(260 * var(--hero-scene-unit, var(--scene-unit-column)));
		height: auto;
	}
</style>
