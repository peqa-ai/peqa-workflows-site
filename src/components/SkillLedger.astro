---
// The skills of the README table «Qué le puedes pedir», in its order, as a ledger: the skill's
// name, one sentence (src/data/skills.ts), the example request of the README and the skill's
// figure (src/data/skill-figures.mjs). A skill without its sentence or its figure fails the build.
import { skillFigures } from '../data/skill-figures.mjs';
import { skillCopy } from '../data/skills';
import { release } from '../lib/release';
import { assertSkillCoverage } from '../lib/skill-coverage.mjs';
import Ledger from './Ledger.astro';
import LedgerRow from './LedgerRow.astro';
import SkillFigure from './SkillFigure.astro';

const lang = Astro.locals.starlightRoute.lang === 'en' ? 'en' : 'es';
const copy = skillCopy[lang];
const names = release.skills.map((skill) => skill.name);
const tag = release.release.tag;
assertSkillCoverage({ skills: names, entries: copy, file: `src/data/skills.ts (${lang})`, tag });
assertSkillCoverage({ skills: names, entries: skillFigures, file: 'src/data/skill-figures.mjs', tag, item: 'figuras para ' });
const rows = release.skills.map((skill) => ({
	name: skill.name,
	summary: copy[skill.name].summary,
	example: lang === 'es' ? skill.example : copy[skill.name].example,
}));
---

<Ledger>
	{
		rows.map((row) => (
			<LedgerRow term={row.name}>
				<p>{row.summary}</p>
				<p>
					<q>{row.example}</q>
				</p>
				<SkillFigure slot="figure" name={row.name} />
			</LedgerRow>
		))
	}
</Ledger>

<style>
	q:lang(es) {
		quotes: '«' '»';
	}
	q:lang(en) {
		quotes: '“' '”';
	}
</style>
