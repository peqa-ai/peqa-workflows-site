---
// One skill's scene in «Qué le puedes pedir» (src/data/skill-figures.mjs): a story without
// text. Its steps follow the scroll, forward and back, where the browser has scroll timelines,
// and play once in time as the scene comes into view otherwise (scene.css). The markup is the
// final frame. The text beside it already says what the skill does, so assistive technology
// skips the drawing.
import { FIGURE_HEIGHT, FIGURE_MARGIN, FIGURE_WIDTH, skillFigures } from '../data/skill-figures.mjs';
import '../styles/scene.css';

interface Props {
	name: string;
}

const figure = skillFigures[Astro.props.name];
if (!figure) throw new Error(`src/data/skill-figures.mjs no tiene la escena de ${Astro.props.name}.`);
// The window onto the drawing ends where its outermost strokes do, a unit past the margins
// (half the widest outline), so every scene starts at its row's left edge and ends at its right.
const viewBox = `${FIGURE_MARGIN - 1} 0 ${FIGURE_WIDTH - 2 * FIGURE_MARGIN + 2} ${FIGURE_HEIGHT}`;
// Drawn strokes measure 1, so scene.css draws any of them with the same dash. The class goes
// apart from the spread, where Astro would replace it with its scope class.
const attributes = (className: string, attrs: Record<string, string | number>) => ({
	...attrs,
	pathLength: className.split(' ').includes('draw') ? 1 : undefined,
});
---

<svg class="scene-art skill-figure" viewBox={viewBox} aria-hidden="true" focusable="false">
	{
		figure.parts.map(([Tag, className, attrs, children]) => (
			<Tag class={className} {...attributes(className, attrs)}>
				{children?.map(([Child, childClass, childAttrs]) => <Child class={childClass} {...attributes(childClass, childAttrs)} />)}
			</Tag>
		))
	}
</svg>

<script>
	import { belowScreen, playOnView, reducedMotion } from '../lib/play-on-view';

	// Decides how the skill scenes move (scene.css). data-motion records the mode: "scroll"
	// where CSS has scroll timelines, "time" otherwise. Only a scene still below the screen
	// moves, so one already visible keeps its final frame and never flickers. With the scroll
	// (data-play="scroll") its story follows the scroll, forward and back. In time it plays
	// once as it comes into view (playOnView). With reduced motion nothing moves.
	const figures = [...document.querySelectorAll<SVGSVGElement>('svg.skill-figure')];
	if (figures.length && !reducedMotion()) {
		const scroll = CSS.supports('animation-timeline: view()');
		const below = figures.filter(belowScreen);
		for (const figure of figures) figure.dataset.motion = scroll ? 'scroll' : 'time';
		if (scroll) for (const figure of below) figure.dataset.play = 'scroll';
		else playOnView(below);
	}
</script>

<style>
	/* As wide as its place in the row, as high as its drawing. */
	svg {
		width: 100%;
		height: auto;
	}
</style>
