---
// Replaces Starlight's Hero on the splash landings: the headline, one sentence and the actions
// from the page's frontmatter and, on pages with `install: true`, the install commands of the
// latest release below them (tabs per client) and the scene of the plugin at work: beside them
// on a wide hero, after them in one column. Starlight's 404 page also uses this hero, without
// commands or scene.
import { LinkButton, TabItem, Tabs } from '@astrojs/starlight/components';
import InstallCommand from './InstallCommand.astro';
import Scene from './Scene.astro';
import { release } from '../lib/release';

const { data } = Astro.locals.starlightRoute.entry;
const { title = data.title, tagline, actions = [] } = data.hero ?? {};
const clients = data.install ? [release.install.claudeCode, release.install.codex] : [];
---

<div class="hero-frame">
<div class:list={['hero', { 'with-scene': clients.length > 0 }]}>
	<div class="lead">
		<h1 id="_top" data-page-title set:html={title} />
		{tagline && <p class="tagline" set:html={tagline} />}
		<div class="actions">
			{actions.map(({ attrs: { class: className, ...attrs } = {}, link: href, text, variant }) => (
				<LinkButton {href} {variant} class:list={[className]} {...attrs}>
					{text}
				</LinkButton>
			))}
			<a class="language" href={Astro.locals.t('peqa.language.href')} hreflang={Astro.locals.t('peqa.language.lang')} lang={Astro.locals.t('peqa.language.lang')}>
				{Astro.locals.t('peqa.language.label')}
			</a>
		</div>
	</div>
	{clients.length > 0 && (
	<section class="install" aria-labelledby="install">
		<h2 id="install">{Astro.locals.t('peqa.install.title')}</h2>
		<Tabs syncKey="peqa-client">
			{
				clients.map((client) => (
					<TabItem label={client.name}>
						<div class="commands">
							{client.command.split('\n').map((command, index) => <InstallCommand {command} number={index + 1} />)}
						</div>
						<p class="then">
							{Astro.locals.t('peqa.install.then')} <code class="scroll-shadows">{client.invoke}</code>
						</p>
					</TabItem>
				))
			}
		</Tabs>
	</section>
	)}
	{clients.length > 0 && (
	<div class="scene">
		<Scene />
	</div>
	)}
</div>
</div>

<style>
	.hero {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: var(--space-6);
		padding-block: var(--space-4) var(--space-6);
	}
	.lead {
		display: grid;
		justify-items: start;
		gap: var(--space-5);
		min-width: 0;
	}
	h1 {
		font-family: var(--font-brand);
		font-weight: var(--weight-title);
		font-size: var(--text-display);
		line-height: var(--leading-tight);
		letter-spacing: var(--tracking-tight);
		color: var(--color-text);
		text-wrap: balance;
		/* Only a word wider than the column, as with text at 200 % at 320 px, breaks instead of
		   widening the page; other lines break as before. */
		overflow-wrap: anywhere;
	}
	.tagline {
		max-width: var(--measure);
		font-size: var(--text-md);
		line-height: var(--leading-body);
		color: var(--color-text);
	}
	.actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: var(--space-3) var(--space-5);
	}
	/* A label wider than the column (320 px with text at 200 %) breaks with a hyphen where the
	   page's language allows, and anywhere as a last resort, instead of widening the page. */
	.actions :global(.sl-link-button) {
		hyphens: auto;
		overflow-wrap: anywhere;
	}
	/* Below Starlight's nav breakpoint, pages without sidebar have no language picker. */
	.language {
		display: inline-flex;
		align-items: center;
		min-height: var(--touch-target);
		font-family: var(--font-mono);
		font-size: var(--text-xs);
		color: var(--color-text);
		text-decoration: underline;
		text-decoration-color: var(--color-accent);
		text-underline-offset: var(--space-2);
	}
	.language:hover {
		color: var(--color-accent);
	}
	.language:active {
		opacity: var(--press-opacity);
	}
	@media (min-width: 50em) {
		.language {
			display: none;
		}
	}
	.install {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: var(--space-3);
		min-width: 0;
	}
	.install h2 {
		font-family: var(--font-mono);
		font-size: var(--text-xs);
		font-weight: var(--weight-normal);
		letter-spacing: normal;
		line-height: var(--leading-body);
		color: var(--color-text);
	}
	/* More space between two commands than between a command's label and its block. */
	.commands {
		display: grid;
		gap: var(--space-5);
	}
	.then {
		margin-top: var(--space-3);
		font-size: var(--text-sm);
		color: var(--color-text);
	}
	/* As the install commands: the invocation moves to the next line whole and, if it is wider
	   than the line, scrolls rather than breaking at a hyphen. */
	.then code {
		display: inline-block;
		max-width: 100%;
		overflow-x: auto;
		white-space: nowrap;
		vertical-align: bottom;
		font-family: var(--font-mono);
		font-size: var(--text-xs);
		padding: var(--space-1) var(--space-2);
		border: var(--border-width) solid var(--color-code-border);
	}
	/* The hero's width decides its columns, in its own em, so text at 200 % stacks them. */
	.hero-frame {
		container: hero / inline-size;
	}
	.scene {
		min-width: 0;
	}
	/* Token --breakpoint-scene: a column too narrow for the scene at its smallest unit, as a
	   phone with text at 200 %, hides it. Its text would not grow with the reader's. */
	@container hero (max-width: 17.875em) {
		.scene {
			display: none;
		}
	}
	/* Token --breakpoint-hero: two columns. */
	@container hero (min-width: 60em) {
		.hero {
			grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
			align-items: center;
			gap: var(--space-8);
			padding-block: var(--section-space);
		}
		/* On the landings the headline, its actions and the install commands share the left
		   column and the scene takes the right one, against the content's right edge. */
		.with-scene {
			grid-template-areas:
				'lead scene'
				'install scene';
			align-items: start;
			row-gap: var(--space-7);
			padding-block: var(--space-7);
		}
		.with-scene .lead {
			grid-area: lead;
		}
		.with-scene .install {
			grid-area: install;
		}
		.with-scene .scene {
			grid-area: scene;
			align-self: center;
			--hero-scene-margin: auto 0;
		}
	}
</style>
