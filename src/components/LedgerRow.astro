---
// One ledger row: `term` in the mono key column, the slot as its value. Inside a reveal scope
// (src/styles/reveal.css) its rule is drawn, its key uncovered and its value takes opacity.
interface Props {
	term: string;
}
const { term } = Astro.props;
---

<div class="row rule-top">
	<dt class="rv rv-wipe">{term}</dt>
	<dd class="rv rv-fade"><slot /></dd>
</div>

<style>
	.row {
		display: grid;
		grid-template-columns: var(--ledger-key-width) minmax(0, 1fr);
		align-items: baseline;
		gap: var(--space-1) var(--space-4);
		padding-block: var(--space-4);
	}
	dt {
		font-family: var(--font-mono);
		font-size: var(--text-sm);
		color: var(--color-text);
		overflow-wrap: anywhere;
	}
	dd {
		display: grid;
		gap: var(--space-2);
		max-width: var(--measure);
		margin: 0;
		min-width: 0;
		color: var(--color-text);
		overflow-wrap: break-word;
	}
	/* A link reaches --touch-target high without growing: an area that high is laid over it,
	   centered on its text. The link keeps the box of its text, so the row keeps its height and
	   the focus ring is drawn around the text, clear of the key above a stacked value. */
	dd :global(a) {
		position: relative;
		color: var(--color-text);
		text-decoration: underline;
		text-decoration-color: var(--color-accent);
		text-underline-offset: var(--space-1);
	}
	dd :global(a::after) {
		content: '';
		position: absolute;
		inset-inline: 0;
		top: 50%;
		height: var(--touch-target);
		transform: translateY(-50%);
	}
	dd :global(a:hover) {
		color: var(--color-accent);
	}
	dd :global(a:active) {
		opacity: var(--press-opacity);
	}
	/* A code chip is higher than its line: a negative margin as deep as its padding keeps the
	   line, and so every row of the ledger, at the same height with or without a chip. */
	dd :global(code) {
		display: inline-block;
		max-width: 100%;
		margin-block: calc(var(--space-1) * -1);
		vertical-align: bottom;
		overflow-wrap: anywhere;
		font-family: var(--font-mono);
		font-size: var(--text-xs);
		padding: var(--space-1) var(--space-2);
		background: var(--color-code-bg);
		border: var(--border-width) solid var(--color-code-border);
	}
	/* Token --ledger-stack-width: a narrow ledger, also with enlarged text, puts the key above its value. */
	@container (max-width: 24rem) {
		.row {
			grid-template-columns: minmax(0, 1fr);
		}
	}
</style>
